<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="database.php" />
          <add segment="db-config.php" />
          <add segment="setup-database.php" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
